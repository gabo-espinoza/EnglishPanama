# Copiar este archivo a .env y completar con valores reales.
# .env nunca se commitea (esta en .gitignore).

PORT=3000

DB_HOST=10.0.0.243
DB_USER=app_user
DB_PASSWORD=
DB_NAME=englishpanama

# Secreto para firmar los JWT de estudiantes y docentes. Usar uno largo y aleatorio;
# si se filtra, cualquiera podria emitir tokens validos. Nunca se comparte ni se sube al repo.
JWT_SECRET=

# CORS: lista de origenes permitidos separados por coma (ej: https://englishpanama.com).
# Vacio = se permiten todos (solo recomendado en desarrollo).
CORS_ORIGIN=

# Poner en true SOLO si hay un proxy inverso (Nginx) delante de la API.
TRUST_PROXY=false

# Solo para el modo demo (avanzar el reto diario en la presentacion).
DEMO_MODE=false

# --- Cuentas de gestion (personal) - Fase A ---
# Contrasena compartida solo para las cuentas de DEMOSTRACION que crea
# scripts/seed-demo-staff.js. No se usa en produccion.
DEMO_STAFF_PASSWORD=

# Secreto PROPIO para firmar los tokens del personal de gestion. Debe ser distinto de
# JWT_SECRET: asi un token de estudiante no sirve para la gestion y viceversa.
STAFF_JWT_SECRET=

# Clave de 32 bytes en base64 para cifrar (AES-256-GCM) el secreto TOTP de cada gestor.
# Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STAFF_MFA_KEY=

# --- Base de datos de auditoria (separada y de solo anexar) ---
# El usuario de auditoria debe tener solo INSERT y SELECT sobre esta base.
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_USER=audit_writer
AUDIT_DB_PASSWORD=
AUDIT_DB_NAME=englishpanama_audit

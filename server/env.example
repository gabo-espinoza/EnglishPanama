# Copiar este archivo a .env y completar con valores reales.
# .env nunca se commitea (está en .gitignore).

PORT=3000

DB_HOST=10.0.0.243
DB_USER=app_user
DB_PASSWORD=
DB_NAME=englishpanama

# Secreto para firmar los JWT. Usar uno largo y aleatorio; si se filtra,
# cualquiera podría emitir tokens válidos. Nunca se comparte ni se sube al repo.
JWT_SECRET=

# CORS: lista de orígenes permitidos separados por coma (ej: https://englishpanama.com).
# Vacío = se permiten todos (solo recomendado en desarrollo).
CORS_ORIGIN=

# Poner en true SOLO si hay un proxy inverso (Nginx) delante de la API.
TRUST_PROXY=false

# Solo para el modo demo (avanzar el reto diario en la presentación).
DEMO_MODE=false
